OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.2
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=100
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SIMILARITY=0.40
# DATABASE_PATH=
AGENT_HISTORY_MESSAGES=8
AGENT_RECURSION_LIMIT=12
PENDING_ACTION_TTL_MINUTES=10

# --- Security (copy to .env; never commit .env) ---
APP_ENV=development
# Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
MCP_TOKEN_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_REQUEST_BYTES=65536
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_ACCOUNT=5
CHAT_RATE_LIMIT=30
SENSITIVE_RATE_LIMIT=10
# Development only: used by `python -m app.security.manage seed-dev-users` (12+ characters)
DEV_SEED_PASSWORD=